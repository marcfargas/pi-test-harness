{
  "name": "@marcfargas/pi-test-harness",
  "version": "0.5.0",
  "description": "Test harness for pi extensions — in-process session testing, package install verification, and subprocess mocking",
  "author": "Marc Fargas",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcfargas/pi-test-harness.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "testing",
    "test-harness",
    "mock",
    "playbook"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "src/**/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/mock-pi-script.mjs','dist/mock-pi-script.mjs')\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ __tests__/",
    "test:unit": "vitest run __tests__/playbook.test.ts __tests__/mock-pi.test.ts",
    "test:integration": "vitest run __tests__/integration.test.ts __tests__/sandbox.test.ts __tests__/fixes.test.ts",
    "test:consumer": "node scripts/consumer-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.74.0",
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.27.0",
    "@earendil-works/pi-agent-core": "^0.75.4",
    "@earendil-works/pi-ai": "^0.75.4",
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "typebox": "^1.1.38",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
